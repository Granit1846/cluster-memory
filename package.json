{
  "name": "cluster-memory",
  "version": "1.2.0",
  "description": "A keyword trail of what an agent already asked and found: a layered search (trail, graph, files, history) that leaves a trace after every answer. Works as a portable agent skill (Claude Code, Codex, Cursor, Gemini CLI) and as a DeepSeek Harness plugin.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Granit1846/cluster-memory.git"
  },
  "homepage": "https://github.com/Granit1846/cluster-memory#readme",
  "bugs": {
    "url": "https://github.com/Granit1846/cluster-memory/issues"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./scripts/cluster-memory.mjs": "./scripts/cluster-memory.mjs"
  },
  "bin": {
    "cluster-memory": "./scripts/cluster-memory.mjs"
  },
  "files": [
    "SKILL.md",
    "index.js",
    "lib",
    "cordis.patch.yml",
    "scripts/cluster-memory.mjs",
    "scripts/self-test.mjs",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/self-test.mjs && node test/smoke.mjs",
    "test:skill": "node scripts/self-test.mjs",
    "test:plugin": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "node": ">=20"
    }
  },
  "keywords": [
    "agent",
    "skill",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "memory",
    "context",
    "compaction",
    "retrieval",
    "keyword-index",
    "graphify",
    "knowledge-graph"
  ]
}
